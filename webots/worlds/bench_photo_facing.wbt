WorldInfo {
  info [
    "ClawBench-UAV drone-photography benchmark world — OPEN / FACING-TARGET variant."
    "Scenario C of three, the easy one. Sibling worlds:"
    "bench_photo_hidden.wbt (A, occluded) and bench_photo_open.wbt (B, clear"
    "line but target behind the drone). All three share the same spawn pad and"
    "the same PERSON_B position; they differ ONLY in the manor placement and"
    "the drone's initial yaw."
    "Here the sight line is clear AND the subject is in frame at t=0: spawn"
    "rotation -2.326155 rad = nav heading 223.3 deg, which is exactly the"
    "bearing to PERSON_B — 0.0 deg off-axis, dead centre of the 70.2 deg HFOV,"
    "at 25.2 m. Nothing needs to be searched for or flown around; what is"
    "being measured is approach and composition alone. If this scenario fails,"
    "the defect is in the composition tier, not in search."
    "Everything else (windmills, pines, road, forest, Tesla) is as in"
    "bench_photo_hidden.wbt."
  ]
  title "ClawBench-UAV Photo Open Subject, Facing Target"
  basicTimeStep 16
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.03132509357312057 -0.004229724205027985 0.9995002991224087 2.901671340011777
  position -17.364913488917383 1.2430003950683964 0.7513423909480075
  near 0.2
  follow "drone_agent"
  followSmoothness 0.2
}
TexturedBackground {
  luminosity 3
}
TexturedBackgroundLight {
}
