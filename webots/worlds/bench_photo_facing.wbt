DEF BENCH_SUPERVISOR Robot {
  translation 0 0 0
  name "benchmark_supervisor"
  model "ClawBench Supervisor"
  description "Ground-truth recorder for the ClawBench-UAV benchmark: trajectory sampling, contact events, object poses, simulation reset."
  locked TRUE
  controller "truth_recorder"
  supervisor TRUE
}
# Scenario C: spawn yaw -2.326155 rad = nav heading 223.3 deg, which is the
# exact bearing from the pad to PERSON_B. She is 0.0 deg off-axis and 25.2 m
# out, so the very first frame contains her.
DEF DRONE Mavic2Pro {
  translation -20.75695 2.170845 0.1
  rotation 0 0 1 -2.326155103016192
  name "drone_agent"
  controller "rgb_agent"
  controllerArgs [
    ""
  ]
  cameraSlot [
    Camera {
      width 960
      height 720
      fieldOfView 1.2252
      near 0.2
    }
  ]
  bodySlot [
    Pose {
      translation 0 0 0.12
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0 0.9 1
            roughness 0.25
            metalness 0
          }
          geometry Sphere {
            radius 0.11
          }
        }
      ]
    }
  ]
}
