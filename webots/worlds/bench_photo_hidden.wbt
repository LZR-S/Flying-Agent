# Occluder: moved from (-50.35, 11.25) onto the spawn->subject line. The
# footprint is ~11.5 x 11 m (half-extent ~5.7 m), walls 6.3 m, ridge 7.34 m.
DEF MANOR SmallManor {
  translation -32 -3.4 0
  rotation 0 0 -1 0.392394
}
SquareManhole {
  translation -20.75695 2.170845 -0.03
}
DEF BOX CardboardBox {
  translation -21.487107 0.941935 0.3
  rotation 0 0 1 -1.8325953071795862
}
# Tesla moved BEHIND PERSON_B, reproducing the car-model relative pose of
# bench_photo_carmodel.wbt exactly: in the person's body frame the car origin
# (rear axle) sits 2.881 m behind and 0.189 m to her right, with car yaw =
# person yaw - 2.0944 rad, i.e. she stands at the car's left-front wheel and
# the body extends forward past her side. Applied to PERSON_B at
# (-42.2944, -8.5472) yaw 2.0 -> car at (-44.8352, -9.9176) yaw -0.0944.
#
# Both bodies then translated 1 m toward the person's right-front, along the
# unit vector (0.93723, -0.34871) derived from her yaw 2.0 (mesh convention
# 1.5708 = +x, so she faces 24.591 deg). The SAME vector is applied to both, so
# the relative pose above is preserved exactly -- centre distance stays
# 2.886808 m and yaw is unchanged, which is what keeps her standing at the
# car's left-front wheel.
DEF TESLA TeslaModel3Simple {
  translation -40.5688 -17.5407 0.31
  rotation 0 0 1 -0.0944
}
# --- Photography subject (single static 3D human, HIDDEN placement) ---------
# PERSON_B stands on the extension of the spawn->manor-centre line, 11.5 m
# past the manor centre: spawn (-20.76, 2.17) -> manor (-32, -3.4) -> person
# (-42.29, -8.55). 24 m from the spawn, ~5.8 m clear of the manor's west wall,
# 11.4 m from WINDMILL_0 — invisible from the spawn at any
# altitude below ~12 m, discoverable by climbing near the building or by
# rounding either side. She faces ENE (yaw 2.0: mesh convention 1.5708 = +x),
# i.e. toward the approach, so a drone arriving around/over the manor sees
# her front. Mesh/material notes as in bench_photo.wbt.
#
# Then translated 1 m toward her own right-front -- the bisector of her facing
# (0.90930, 0.41614) and her right (0.41614, -0.90930), i.e. the unit vector
# (0.93723, -0.34871). New position (-41.3572, -8.8959): 23.39 m from the
# spawn, still 2.91 m clear of the manor half-extent, and still fully occluded
# from the spawn at low altitude. TESLA is translated by the same vector, so
# the two keep their exact relative pose.
DEF PERSON_B Solid {
  translation  -38.0280 -16.1703 0.95
  rotation 0 0 1 2.0
  children [
    Pose {
      rotation 1 0 0 1.5708
      children [
        Shape {
          castShadows FALSE
          geometry Mesh {
            url [
              "../assets_created/Meshy_Elven_Warrior/Meshy_AI_Elven_Warrior_in_Gree_0708065940_texture.obj"
            ]
          }
          appearance PBRAppearance {
            baseColorMap ImageTexture {
              url [
                "../assets_created/Meshy_Elven_Warrior/Meshy_AI_Elven_Warrior_in_Gree_0708065940_texture.png"
              ]
            }
            roughness 1
            metalness 0
          }
        }
      ]
    }
  ]
  name "person_b"
}
