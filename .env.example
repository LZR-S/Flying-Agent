# OpenLux: used by the dashboard and the CLI --env-file option.
BASE_URL=https://api.openlux.ai/
API_KEY=

# Optional AliCloud provider, selected from the dashboard.
AliCloud_url=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AliCloud_key=

# Optional image provider overrides. Otherwise BASE_URL/API_KEY above are used,
# independently of the selected decision-model provider (including AliCloud).
# DRONE_PHOTO_IMAGE_BASE_URL=https://api.openlux.ai/
# DRONE_PHOTO_IMAGE_API_KEY=
